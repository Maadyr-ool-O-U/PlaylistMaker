<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yp_blue"
    android:paddingBottom="@dimen/margin_padding_standard"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_title"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/margin_padding_standard"
        android:paddingEnd="@dimen/margin_padding_standard"   />

    <Button
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_padding_standard"
        android:layout_marginEnd="@dimen/margin_padding_standard"
        android:layout_marginTop="@dimen/margin_padding_standard"
        android:backgroundTint="@color/white"
        android:text="@string/search"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:icon="@drawable/ic_search"
        app:iconTint="@color/yp_black"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/icon_padding_size"
        app:cornerRadius="@dimen/margin_padding_standard" />
    <Button
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_padding_standard"
        android:layout_marginEnd="@dimen/margin_padding_standard"
        android:layout_marginTop="@dimen/margin_padding_standard"
        android:backgroundTint="@color/white"
        android:text="@string/media_library"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:icon="@drawable/ic_library"
        app:iconTint="@color/yp_black"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/icon_padding_size"
        app:cornerRadius="@dimen/margin_padding_standard" />
    <Button
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_padding_standard"
        android:layout_marginEnd="@dimen/margin_padding_standard"
        android:layout_marginTop="@dimen/margin_padding_standard"
        android:backgroundTint="@color/white"
        android:text="@string/settings"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:icon="@drawable/ic_settings"
        app:iconTint="@color/yp_black"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/icon_padding_size"
        app:cornerRadius="@dimen/margin_padding_standard" />

</LinearLayout>