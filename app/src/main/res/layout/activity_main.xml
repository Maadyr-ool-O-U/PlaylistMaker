<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yp_blue"
    android:paddingBottom="@dimen/margin_padding_standard"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_title"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/margin_padding_standard"
        android:paddingEnd="@dimen/margin_padding_standard"   />

    <Button
        android:id="@+id/btn_search"
        android:text="@string/search"
        style="@style/MainButtonStyle"  />

    <Button
        android:id="@+id/btn_media_library"
        android:text="@string/media_library"
        style="@style/MainButtonStyle"  />

    <Button
        android:id="@+id/btn_settings"
        android:text="@string/settings"
        style="@style/MainButtonStyle"  />

</LinearLayout>