<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSecondary">

    <LinearLayout
        style="@style/HeaderContainerStyle" >

        <ImageView
            android:id="@+id/iv_arrow_back"
            style="@style/HeaderBackButtonStyle" />

        <TextView
            android:text="@string/settings"
            style="@style/HeaderTitleStyle"    />

    </LinearLayout>
    <LinearLayout
        style="@style/SettingsItemContainer">

        <TextView
            android:text="@string/dark_theme"
            style="@style/SettingsItemText" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/theme_switcher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color" />

    </LinearLayout>
    <LinearLayout
        style="@style/SettingsItemContainer">

        <TextView
            android:text="@string/share"
            style="@style/SettingsItemText" />

        <ImageView
            android:id="@+id/share_container"
            android:src="@drawable/ic_share"
            android:contentDescription="@string/share"
            style="@style/SettingsItemIcon"/>

    </LinearLayout>
    <LinearLayout
        style="@style/SettingsItemContainer">

        <TextView
            android:text="@string/support"
            style="@style/SettingsItemText" />

        <ImageView
            android:id="@+id/support_container"
            android:src="@drawable/ic_support"
            android:contentDescription="@string/support"
            style="@style/SettingsItemIcon" />

    </LinearLayout>
    <LinearLayout
        style="@style/SettingsItemContainer">

        <TextView
            android:text="@string/agreement"
            style="@style/SettingsItemText" />

        <ImageView
            android:id="@+id/agreement_container"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="@string/agreement"
            style="@style/SettingsItemIcon" />

    </LinearLayout>
</LinearLayout>