<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSecondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_arrow_back"
            android:src="@drawable/ic_arrow_back"
            android:layout_width="@dimen/touch_target_size"
            android:layout_height="@dimen/touch_target_size"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorOnSecondary"
            android:contentDescription="@string/back"  />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_title_start"
            android:text="@string/settings"
            android:textColor="?attr/colorOnSecondary"
            android:textSize="@dimen/text_size_title"
            android:fontFamily="@font/ys_display_medium"    />
    </LinearLayout>
    <LinearLayout
        style="@style/SettingsItemContainer">

        <TextView
            android:text="@string/dark_theme"
            style="@style/SettingsItemText" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/theme_switcher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color" />

    </LinearLayout>
    <LinearLayout
        style="@style/SettingsItemContainer">

        <TextView
            android:text="@string/share"
            style="@style/SettingsItemText" />

        <ImageView
            android:src="@drawable/ic_share"
            android:contentDescription="@string/share"
            style="@style/SettingsItemIcon"/>

    </LinearLayout>
    <LinearLayout
        style="@style/SettingsItemContainer">

        <TextView
            android:text="@string/support"
            style="@style/SettingsItemText" />

        <ImageView
            android:src="@drawable/ic_support"
            android:contentDescription="@string/support"
            style="@style/SettingsItemIcon" />

    </LinearLayout>
    <LinearLayout
        style="@style/SettingsItemContainer">

        <TextView
            android:text="@string/agreement"
            style="@style/SettingsItemText" />

        <ImageView
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="@string/agreement"
            style="@style/SettingsItemIcon" />

    </LinearLayout>
</LinearLayout>